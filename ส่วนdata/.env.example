# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าของตัวเอง (ห้าม commit ไฟล์ .env)

# ที่อยู่ฐานข้อมูล MongoDB เช่นจาก MongoDB Atlas
MONGODB_URI=

# กุญแจสำหรับเซ็น JWT ใช้ข้อความสุ่มยาว ๆ
JWT_SECRET=

# อายุของ JWT
JWT_EXPIRES_IN=7d

# พอร์ตของเซิร์ฟเวอร์
PORT=4000

# ที่อยู่ของหน้าเกมที่อนุญาตให้เรียก API คั่นหลายค่าด้วยเครื่องหมาย ,
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
